rules_version = '2';

/**
 * ==============================================================================
 * TASKFLOW — FIRESTORE SECURITY RULES (firestore.rules)
 * Production security rules enforcing strict per-user data isolation.
 * ==============================================================================
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if client is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verify client UID matches the target user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --------------------------------------------------------------------------
    // User Profile Documents: users/{userId}
    // --------------------------------------------------------------------------
    match /users/{userId} {
      // Users can only read and write their own profile document
      allow read, write: if isOwner(userId);

      // ------------------------------------------------------------------------
      // Nested User Tasks: users/{userId}/tasks/{taskId}
      // ------------------------------------------------------------------------
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --------------------------------------------------------------------------
    // Root Tasks Collection (Alternative schema): tasks/{taskId}
    // --------------------------------------------------------------------------
    match /tasks/{taskId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

